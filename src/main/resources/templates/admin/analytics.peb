<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineStats - Movie Theater Analytics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <link rel="stylesheet" href="/admin/analytics.css">
    <link rel="stylesheet" href="/topbar/bar.css">
    <meta name="_csrf" content="{{ _csrf.token }}">
    <meta name="_csrf_header" content="{{ _csrf.headerName }}">
</head>
<body>
<!-- Theme Toggle -->
<div class="theme-toggle">
    <div class="dropdown">
        <button class="theme-btn" type="button" id="themeToggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-moon-stars-fill"></i>
        </button>
        <ul class="dropdown-menu theme-menu" aria-labelledby="themeToggle">
            <li><button class="dropdown-item theme-item" data-bs-theme-value="light"><i class="bi bi-sun-fill"></i>Light</button></li>
            <li><button class="dropdown-item theme-item active" data-bs-theme-value="dark"><i class="bi bi-moon-stars-fill"></i>Dark</button></li>
            <li><button class="dropdown-item theme-item" data-bs-theme-value="auto"><i class="bi bi-circle-half"></i>Auto</button></li>
        </ul>
    </div>
</div>

<!-- Navigation -->
<div class="nav-container">
    <div class="container py-2">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="logo-text m-0">Absolute Cinema</h1>
            <div class="search-container">
                <i class="bi bi-search search-icon"></i>
                <input id="searchInput" type="search" class="form-control" placeholder="Search movies..." aria-label="Search movies" autocomplete="off">
                <div id="filterDropdown" class="filter-dropdown dropdown-menu shadow" style="display: none;">
                    <div class="filter-section">
                        <div class="filter-section-title">Browse by genre</div>
                        <a class="filter-option" href="/movies/search?genre=Action">Action</a>
                        <a class="filter-option" href="/movies/search?genre=Animation">Animation</a>
                        <a class="filter-option" href="/movies/search?genre=Comedy">Comedy</a>
                        <a class="filter-option" href="/movies/search?genre=Drama">Drama</a>
                        <a class="filter-option" href="/movies/search?genre=Horror">Horror</a>
                        <a class="filter-option" href="/movies/search?genre=Romance">Romance</a>
                        <a class="filter-option" href="/movies/search?genre=Sci-Fi">Sci-Fi</a>
                        <a class="filter-option" href="/movies/search?genre=Thriller">Thriller</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center mt-3">
            <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 mb-md-0">
                <li><a href="/admin/dashboard" class="nav-link px-2">Dashboard</a></li>
                <li><a href="/admin/analytics" class="nav-link px-2">Analytics</a></li>
                <li><a href="/admin/manageproduct" class="nav-link px-2">Movies &amp; Snacks</a></li>
                <li><a href="/admin/managebooking" class="nav-link px-2">Bookings</a></li>
                <li><a href="/admin/manageloyalty" class="nav-link px-2">Loyalty</a></li>
                <li><a href="/admin/managefeedback" class="nav-link px-2">Feedback</a></li>
                <li><a href="/admin/messages" class="nav-link px-2">Inbox</a></li>
                <li><a href="/account/settings" class="nav-link px-2">Settings</a></li>
                <li><a href="/logout" class="nav-link px-2 text-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a></li>
            </ul>
        </div>
    </div>
</div>
        <!-- Page Header -->
        <div class="page-header">
            <h2>Sales Analytics</h2>
        </div>

        <!-- Stats Cards -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="icon"><i class="fas fa-ticket-alt"></i></div>
                <div class="stat-info">
                    <div class="label">Tickets Sold</div>
                    <div class="value">{{ report.ticketsSold | numberformat("#,##0") }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="icon"><i class="fas fa-cookie"></i></div>
                <div class="stat-info">
                    <div class="label">Snacks Sold</div>
                    <div class="value">{{ report.snacksSold | numberformat("#,##0") }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="icon"><i class="fas fa-dollar-sign"></i></div>
                <div class="stat-info">
                    <div class="label">Booking Revenue</div>
                    <div class="value">PKR {{ report.totalRevenue | numberformat("#,##0") }}</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="icon"><i class="fas fa-star"></i></div>
                <div class="stat-info">
                    <div class="label">Average Rating ({{ report.bookings }} bookings)</div>
                    <div class="value">{{ report.averageRating | numberformat("0.0") }} / 5</div>
                </div>
            </div>
        </div>

        <!-- Revenue Charts -->
        <div class="charts-container">
            <div class="chart-card">
                <div class="chart-header">
                    <h4>Monthly Revenue: Tickets and Snacks</h4>
                </div>
                <div class="chart-body">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
            <div class="chart-card">
                <div class="chart-header">
                    <h4>Revenue Split</h4>
                </div>
                <div class="chart-body">
                    <canvas id="revenueSplitChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Genres and Top Movies -->
        <div class="charts-container">
            <div class="chart-card">
                <div class="chart-header">
                    <h4>Tickets Sold by Genre</h4>
                </div>
                <div class="chart-body">
                    <canvas id="genreChart"></canvas>
                </div>
            </div>
            <div class="chart-card-stats">
                <div class="chart-header">
                    <h4>Popular Movies</h4>
                </div>
                <div class="chart-body">
                    <ul class="top-movies-list">
                        {% for movie in report.topMovies %}
                        <li>
                            <div class="movie-rank">{{ loop.index + 1 }}</div>
                            <div class="movie-info">
                                <div class="movie-title">{{ movie.title }}</div>
                                <div class="movie-stats"><span>{{ movie.genre }}</span> • <span>{{ movie.duration }} min</span></div>
                            </div>
                            <div class="movie-revenue">{{ movie.ticketssold | numberformat("#,##0") }} tickets</div>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <!-- Popular Snacks -->
        <div class="charts-container">
            <div class="chart-card-stats">
                <div class="chart-header">
                    <h4>Popular Snacks</h4>
                </div>
                <div class="chart-body">
                    <ul class="popular-snacks-list">
                        {% for snack in report.topSnacks %}
                        <li>
                            <div class="snack-icon"><i class="fas fa-bowl-food"></i></div>
                            <div class="snack-info">
                                <div class="snack-name">{{ snack.name }}</div>
                                <div class="snack-stats">PKR {{ snack.price | numberformat("#,##0.00") }} each • {{ snack.quantity }} in stock</div>
                            </div>
                            <div class="snack-quantity">{{ snack.snackssold | numberformat("#,##0") }} sold</div>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="chart-card">
                <div class="chart-header">
                    <h4>Snack Sales Value by Item</h4>
                </div>
                <div class="chart-body">
                    <canvas id="snacksRevenueChart"></canvas>
                </div>
            </div>
        </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
<script src="/topbar/bar.js"></script>
<script>
const months = [{% for m in report.monthlyRevenue %}'{{ m.label | escape(strategy="js") }}'{% if not loop.last %}, {% endif %}{% endfor %}];
const monthlyTicketRevenue = [{% for m in report.monthlyRevenue %}{{ m.ticketRevenue }}{% if not loop.last %}, {% endif %}{% endfor %}];
const monthlySnackRevenue = [{% for m in report.monthlyRevenue %}{{ m.snackRevenue }}{% if not loop.last %}, {% endif %}{% endfor %}];
const genres = [{% for genre in report.ticketsByGenre %}'{{ genre.key | escape(strategy="js") }}'{% if not loop.last %}, {% endif %}{% endfor %}];
const genreTickets = [{% for genre in report.ticketsByGenre %}{{ genre.value }}{% if not loop.last %}, {% endif %}{% endfor %}];
const snackNames = [{% for snack in report.topSnacks %}'{{ snack.name | escape(strategy="js") }}'{% if not loop.last %}, {% endif %}{% endfor %}];
const snackSalesValue = [{% for snack in report.topSnacks %}{{ snack.price * snack.snackssold }}{% if not loop.last %}, {% endif %}{% endfor %}];

const axisColor = '#8a8d99';
const gridColor = 'rgba(255, 255, 255, 0.05)';
const pkr = value => 'PKR ' + Number(value).toLocaleString();
const axes = (yFormat) => ({
    y: { beginAtZero: true, grid: { color: gridColor }, ticks: { color: axisColor, callback: yFormat } },
    x: { grid: { color: gridColor }, ticks: { color: axisColor } }
});

new Chart(document.getElementById('revenueChart'), {
    type: 'line',
    data: {
        labels: months,
        datasets: [
            { label: 'Tickets', data: monthlyTicketRevenue, borderColor: '#722ed1', backgroundColor: 'rgba(114, 46, 209, 0.1)', tension: 0.4, fill: true },
            { label: 'Snacks', data: monthlySnackRevenue, borderColor: '#1677ff', backgroundColor: 'rgba(22, 119, 255, 0.1)', tension: 0.4, fill: true }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'top', labels: { color: axisColor } },
            tooltip: { mode: 'index', intersect: false, callbacks: { label: c => `${c.dataset.label}: ${pkr(c.raw)}` } }
        },
        scales: axes(pkr)
    }
});

new Chart(document.getElementById('revenueSplitChart'), {
    type: 'doughnut',
    data: {
        labels: ['Tickets', 'Snacks'],
        datasets: [{ data: [{{ report.ticketRevenue }}, {{ report.snackRevenue }}], backgroundColor: ['#722ed1', '#1677ff'], borderWidth: 0 }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'right', labels: { color: axisColor } },
            tooltip: { callbacks: { label: c => `${c.label}: ${pkr(c.raw)}` } }
        },
        cutout: '70%'
    }
});

new Chart(document.getElementById('genreChart'), {
    type: 'bar',
    data: { labels: genres, datasets: [{ label: 'Tickets sold', data: genreTickets, backgroundColor: 'rgba(114, 46, 209, 0.7)', borderWidth: 0 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: axes(v => v) }
});

new Chart(document.getElementById('snacksRevenueChart'), {
    type: 'bar',
    data: { labels: snackNames, datasets: [{ label: 'Sales value', data: snackSalesValue, backgroundColor: '#36cfc9', borderWidth: 0 }] },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => pkr(c.raw) } } },
        scales: axes(pkr)
    }
});
</script>
</body>
</html>
