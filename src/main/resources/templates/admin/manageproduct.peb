<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <link rel="stylesheet" href="/admin/manageloyalty.css">
    <link rel="stylesheet" href="/topbar/bar.css">
    <meta name="_csrf" content="{{ _csrf.token }}">
    <meta name="_csrf_header" content="{{ _csrf.headerName }}">
</head>
<body>
<!-- Theme Toggle -->
<div class="theme-toggle">
    <div class="dropdown">
        <button class="theme-btn" type="button" id="themeToggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-moon-stars-fill"></i>
        </button>
        <ul class="dropdown-menu theme-menu" aria-labelledby="themeToggle">
            <li><button class="dropdown-item theme-item" data-bs-theme-value="light"><i class="bi bi-sun-fill"></i>Light</button></li>
            <li><button class="dropdown-item theme-item active" data-bs-theme-value="dark"><i class="bi bi-moon-stars-fill"></i>Dark</button></li>
            <li><button class="dropdown-item theme-item" data-bs-theme-value="auto"><i class="bi bi-circle-half"></i>Auto</button></li>
        </ul>
    </div>
</div>

<!-- Navigation -->
<div class="nav-container">
    <div class="container py-2">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="logo-text m-0">Absolute Cinema</h1>
            <div class="search-container">
                <i class="bi bi-search search-icon"></i>
                <input id="searchInput" type="search" class="form-control" placeholder="Search movies..." aria-label="Search movies" autocomplete="off">
                <div id="filterDropdown" class="filter-dropdown dropdown-menu shadow" style="display: none;">
                    <div class="filter-section">
                        <div class="filter-section-title">Browse by genre</div>
                        <a class="filter-option" href="/movies/search?genre=Action">Action</a>
                        <a class="filter-option" href="/movies/search?genre=Animation">Animation</a>
                        <a class="filter-option" href="/movies/search?genre=Comedy">Comedy</a>
                        <a class="filter-option" href="/movies/search?genre=Drama">Drama</a>
                        <a class="filter-option" href="/movies/search?genre=Horror">Horror</a>
                        <a class="filter-option" href="/movies/search?genre=Romance">Romance</a>
                        <a class="filter-option" href="/movies/search?genre=Sci-Fi">Sci-Fi</a>
                        <a class="filter-option" href="/movies/search?genre=Thriller">Thriller</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center mt-3">
            <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 mb-md-0">
                <li><a href="/admin/dashboard" class="nav-link px-2">Dashboard</a></li>
                <li><a href="/admin/analytics" class="nav-link px-2">Analytics</a></li>
                <li><a href="/admin/manageproduct" class="nav-link px-2">Movies &amp; Snacks</a></li>
                <li><a href="/admin/managebooking" class="nav-link px-2">Bookings</a></li>
                <li><a href="/admin/manageloyalty" class="nav-link px-2">Loyalty</a></li>
                <li><a href="/admin/managefeedback" class="nav-link px-2">Feedback</a></li>
                <li><a href="/admin/messages" class="nav-link px-2">Inbox</a></li>
                <li><a href="/account/settings" class="nav-link px-2">Settings</a></li>
                <li><a href="/logout" class="nav-link px-2 text-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a></li>
            </ul>
        </div>
    </div>
</div>
    <!-- Management Section -->
    <div class="management-container">
      <div class="tabs-container">
        <button class="tab-btn active" data-tab="movies">Movies ({{ movies | length }})</button>
        <button class="tab-btn" data-tab="snacks">Snacks ({{ snacks | length }})</button>
      </div>

      <div class="tab-content">
        <!-- Movies Tab -->
        <div class="tab-panel active" id="movies-panel">
          <div class="top-actions">
            <div class="search-bar">
              <input type="text" placeholder="Search movies...">
              <button type="button"><i class="fas fa-search"></i></button>
            </div>
            <button type="button" class="add-new-btn" id="addMovieBtn"><i class="fas fa-plus"></i> Add Movie</button>
          </div>

          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Poster</th>
                  <th>Title</th>
                  <th>Genre</th>
                  <th>Release Date</th>
                  <th>Tickets Sold</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for movie in movies %}
                <tr data-row>
                  <td>#M{{ movie.id }}</td>
                  <td><img src="{{ movie.posterUrl | default('/images/movies/default.svg') }}" alt="{{ movie.title }} poster" width="40" height="60" style="object-fit: cover; border-radius: 4px;" onerror="this.src='/images/movies/default.svg'"></td>
                  <td>{{ movie.title }}</td>
                  <td>{{ movie.genre }}</td>
                  <td>{{ movie.releaseDate }}</td>
                  <td>{{ movie.ticketssold }}</td>
                  <td>
                    <button type="button" class="action-btn edit-btn edit-movie-btn" title="Edit movie"
                            data-id="{{ movie.id }}" data-title="{{ movie.title }}" data-genre="{{ movie.genre }}"
                            data-director="{{ movie.director }}" data-language="{{ movie.language }}"
                            data-duration="{{ movie.duration }}" data-release-date="{{ movie.releaseDate }}"
                            data-poster-url="{{ movie.posterUrl }}" data-description="{{ movie.description }}">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="action-btn delete-btn" title="Delete movie"
                            data-delete-url="/api/movies/{{ movie.id }}" data-label="{{ movie.title }}">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center">No movies yet.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Snacks Tab -->
        <div class="tab-panel" id="snacks-panel">
          <div class="top-actions">
            <div class="search-bar">
              <input type="text" placeholder="Search snacks...">
              <button type="button"><i class="fas fa-search"></i></button>
            </div>
            <button type="button" class="add-new-btn" id="addSnackBtn"><i class="fas fa-plus"></i> Add Snack</button>
          </div>

          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Description</th>
                  <th>Price</th>
                  <th>In Stock</th>
                  <th>Sold</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for snack in snacks %}
                <tr data-row>
                  <td>#S{{ snack.id }}</td>
                  <td>{{ snack.name }}</td>
                  <td>{{ snack.description }}</td>
                  <td>PKR {{ snack.price | numberformat("#,##0.00") }}</td>
                  <td>{{ snack.quantity }}</td>
                  <td>{{ snack.snackssold }}</td>
                  <td>
                    <button type="button" class="action-btn edit-btn edit-snack-btn" title="Edit snack"
                            data-id="{{ snack.id }}" data-name="{{ snack.name }}" data-description="{{ snack.description }}"
                            data-price="{{ snack.price }}" data-quantity="{{ snack.quantity }}" data-image-url="{{ snack.imageUrl }}">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="action-btn delete-btn" title="Delete snack"
                            data-delete-url="/api/snacks/{{ snack.id }}" data-label="{{ snack.name }}">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center">No snacks yet.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  <!-- Add/Edit Movie Modal -->
  <div id="movieModal" class="modal">
    <div class="modal-content">
      <span class="close-btn">&times;</span>
      <h3 class="modal-title">Add New Movie</h3>
      <form id="movieForm">
        <div class="form-group">
          <label class="form-label" for="movieTitle">Title</label>
          <input type="text" class="form-control" id="movieTitle" name="title" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="movieGenre">Genre</label>
          <input type="text" class="form-control" id="movieGenre" name="genre" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="movieDirector">Director</label>
          <input type="text" class="form-control" id="movieDirector" name="director" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="movieLanguage">Language</label>
          <input type="text" class="form-control" id="movieLanguage" name="language" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="movieDuration">Duration (minutes)</label>
          <input type="number" class="form-control" id="movieDuration" name="duration" min="1" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="movieReleaseDate">Release Date</label>
          <input type="date" class="form-control" id="movieReleaseDate" name="releaseDate" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="moviePosterUrl">Poster URL</label>
          <input type="url" class="form-control" id="moviePosterUrl" name="posterUrl" placeholder="https://...">
        </div>
        <div class="form-group">
          <label class="form-label" for="movieDescription">Description</label>
          <textarea class="form-control" id="movieDescription" name="description" rows="3" required></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="cancel-btn">Cancel</button>
          <button type="submit" class="save-btn">Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add/Edit Snack Modal -->
  <div id="snackModal" class="modal">
    <div class="modal-content">
      <span class="close-btn">&times;</span>
      <h3 class="modal-title">Add New Snack</h3>
      <form id="snackForm">
        <div class="form-group">
          <label class="form-label" for="snackName">Name</label>
          <input type="text" class="form-control" id="snackName" name="name" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="snackDescription">Description</label>
          <input type="text" class="form-control" id="snackDescription" name="description" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="snackImageUrl">Image URL</label>
          <input type="text" class="form-control" id="snackImageUrl" name="imageUrl" placeholder="/images/snacks/popcorn.jpg or https://...">
        </div>
        <div class="form-group">
          <label class="form-label" for="snackPrice">Price (PKR)</label>
          <input type="number" class="form-control" id="snackPrice" name="price" min="0" step="0.01" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="snackQuantity">Quantity in stock</label>
          <input type="number" class="form-control" id="snackQuantity" name="quantity" min="0" required>
        </div>
        <div class="modal-footer">
          <button type="button" class="cancel-btn">Cancel</button>
          <button type="submit" class="save-btn">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/topbar/bar.js"></script>
  <script src="/admin/admin.js"></script>
  <script>
    // Wires a modal form to create (POST) or update (PUT) a resource, then reloads the page.
    function bindEntityForm({ modalId, addBtnId, editSelector, apiUrl, noun, numericFields }) {
      const modal = document.getElementById(modalId);
      const form = modal.querySelector('form');
      const title = modal.querySelector('.modal-title');
      let editingId = null;

      const open = (id, values) => {
        editingId = id;
        title.textContent = id ? `Edit ${noun}` : `Add New ${noun}`;
        form.reset();
        Object.entries(values).forEach(([name, value]) => {
          if (form.elements[name]) {
            form.elements[name].value = value;
          }
        });
        modal.style.display = 'block';
      };
      const close = () => { modal.style.display = 'none'; };

      document.getElementById(addBtnId).addEventListener('click', () => open(null, {}));
      document.querySelectorAll(editSelector).forEach(btn => {
        const { id, ...values } = btn.dataset;
        btn.addEventListener('click', () => open(id, values));
      });
      modal.querySelector('.close-btn').addEventListener('click', close);
      modal.querySelector('.cancel-btn').addEventListener('click', close);
      window.addEventListener('click', e => { if (e.target === modal) close(); });

      form.addEventListener('submit', async e => {
        e.preventDefault();
        const payload = Object.fromEntries(new FormData(form));
        numericFields.forEach(field => { payload[field] = Number(payload[field]); });
        const saveBtn = form.querySelector('.save-btn');
        saveBtn.disabled = true;
        try {
          await apiRequest(editingId ? 'PUT' : 'POST', editingId ? `${apiUrl}/${editingId}` : apiUrl, payload);
          location.reload();
        } catch (error) {
          console.error(error);
          alert(`Could not save the ${noun.toLowerCase()}. Please check the fields and try again.`);
          saveBtn.disabled = false;
        }
      });
    }

    bindEntityForm({
      modalId: 'movieModal', addBtnId: 'addMovieBtn', editSelector: '.edit-movie-btn',
      apiUrl: '/api/movies', noun: 'Movie', numericFields: ['duration']
    });
    bindEntityForm({
      modalId: 'snackModal', addBtnId: 'addSnackBtn', editSelector: '.edit-snack-btn',
      apiUrl: '/api/snacks', noun: 'Snack', numericFields: ['price', 'quantity']
    });
  </script>
</body>
</html>
