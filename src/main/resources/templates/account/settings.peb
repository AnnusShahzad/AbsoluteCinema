<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - Absolute Cinema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/checkout.css">
</head>
<body>
<header class="checkout-header">
    <a class="checkout-logo" href="{{ homeUrl }}">Absolute Cinema</a>
    <div class="d-flex gap-2">
        <a class="btn-ghost" href="{{ homeUrl }}"><i class="bi bi-arrow-left"></i> Back</a>
        <a class="btn-ghost" href="/logout"><i class="bi bi-box-arrow-right"></i> Sign out</a>
    </div>
</header>

<main class="checkout-main" style="max-width: 820px;">
    <h1 class="h3 fw-bold mb-1">Account settings</h1>
    <p class="muted mb-4">Signed in as <strong>{{ user.username }}</strong> ({{ user.accountType | capitalize }})</p>

    <section class="checkout-card mb-4" id="profile">
        <h2>Profile</h2>
        {% if profileMessage %}<p class="notice" role="status">{{ profileMessage }}</p>{% endif %}
        {% if profileError %}<p class="error-text" role="alert">{{ profileError }}</p>{% endif %}
        <form method="post" action="/account/profile" class="row g-3">
            <input type="hidden" name="{{ _csrf.parameterName }}" value="{{ _csrf.token }}">
            <div class="col-md-6">
                <label class="form-label" for="firstName">First name</label>
                <input class="form-control" id="firstName" name="firstName" value="{{ user.firstName }}" maxlength="50" autocomplete="given-name" required>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="lastName">Last name</label>
                <input class="form-control" id="lastName" name="lastName" value="{{ user.lastName }}" maxlength="50" autocomplete="family-name" required>
            </div>
            <div class="col-12">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" type="email" id="email" name="email" value="{{ user.email }}" autocomplete="email" required>
            </div>
            <div class="col-12">
                <button class="btn-accent" type="submit" style="width: auto;">Save profile</button>
            </div>
        </form>
    </section>

    <section class="checkout-card" id="password">
        <h2>Password</h2>
        {% if passwordMessage %}<p class="notice" role="status">{{ passwordMessage }}</p>{% endif %}
        {% if passwordError %}<p class="error-text" role="alert">{{ passwordError }}</p>{% endif %}
        <form method="post" action="/account/password" class="row g-3">
            <input type="hidden" name="{{ _csrf.parameterName }}" value="{{ _csrf.token }}">
            <div class="col-12">
                <label class="form-label" for="currentPassword">Current password</label>
                <input class="form-control" type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="newPassword">New password</label>
                <input class="form-control" type="password" id="newPassword" name="newPassword" minlength="{{ minPasswordLength }}" autocomplete="new-password" required>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="confirmPassword">Confirm new password</label>
                <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" minlength="{{ minPasswordLength }}" autocomplete="new-password" required>
            </div>
            <div class="col-12">
                <button class="btn-accent" type="submit" style="width: auto;">Change password</button>
            </div>
        </form>
    </section>
</main>
</body>
</html>
