        <a href="/movies">Movies</a>
        <a href="/bookings/history">My Bookings</a>
        <a href="/loyalty">Loyalty</a>
        <a href="/feedback">Feedback</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/topbar/bar.js"></script>
  <script>
    const regularPrice = {{ regularPrice }};
    const premiumPrice = {{ premiumPrice }};
    const movieId = '{{ movie.id }}';
    const sessionSelect = document.getElementById('sessionSelect');
    const seatElements = document.querySelectorAll('.seat');
    const selectedSeatsContainer = document.getElementById('selectedSeatsContainer');
    const continueBtn = document.getElementById('continueBtn');
    const totalPriceElement = document.querySelector('.total-price-value');
    let selectedSeats = [];

    const seatLabel = seat => seat.dataset.row + seat.dataset.seat;
    const formatPkr = amount => `PKR ${amount.toLocaleString()}`;

    function renderSelection() {
      if (selectedSeats.length === 0) {
        selectedSeatsContainer.innerHTML = '<p class="text-center text-muted">No seats selected yet</p>';
      } else {
        const list = document.createElement('ul');
        list.className = 'selected-seats';
        selectedSeats.forEach(seat => {
          const item = document.createElement('li');
          item.className = 'selected-seat-item';
          item.innerHTML = '<span></span><span class="seat-price"></span>';
          item.children[0].textContent = `${seat.label}${seat.premium ? ' (Premium)' : ''}`;
          item.children[1].textContent = formatPkr(seat.price);
          list.appendChild(item);
        });
        selectedSeatsContainer.replaceChildren(list);
      }
      totalPriceElement.textContent = formatPkr(selectedSeats.reduce((sum, seat) => sum + seat.price, 0));
      continueBtn.disabled = selectedSeats.length === 0 || !sessionSelect.value;
    }

    // Marks seats sold for the chosen showtime; no seat can be picked until a showtime is chosen.
    async function loadOccupiedSeats() {
      selectedSeats = [];
      seatElements.forEach(seat => seat.classList.remove('selected', 'occupied'));
      if (!sessionSelect.value) {
        seatElements.forEach(seat => seat.classList.add('occupied'));
        renderSelection();
        return;
      }
      try {
        const response = await fetch(`/api/sessions/${sessionSelect.value}/occupied-seats`);
        const occupied = new Set(await response.json());
        seatElements.forEach(seat => seat.classList.toggle('occupied', occupied.has(seatLabel(seat))));
      } catch (error) {
        console.error(error);
        alert('Could not load seat availability. Please try again.');
      }
      renderSelection();
    }

    seatElements.forEach(seat => {
      seat.addEventListener('click', () => {
        if (seat.classList.contains('occupied')) {
          return;
        }
        const label = seatLabel(seat);
        if (seat.classList.toggle('selected')) {
          const premium = seat.classList.contains('premium');
          selectedSeats.push({ label, premium, price: premium ? premiumPrice : regularPrice });
        } else {
          selectedSeats = selectedSeats.filter(s => s.label !== label);
        }
        renderSelection();
      });
    });

    continueBtn.addEventListener('click', () => {
      const orderDetails = {
        movieId,
        movieTitle: document.querySelector('.movie-info-title').textContent,
        sessionId: sessionSelect.value,
        sessionTime: sessionSelect.options[sessionSelect.selectedIndex].text,
        seats: selectedSeats,
        snacks: {}
      };
      sessionStorage.setItem('orderDetails', JSON.stringify(orderDetails));
      window.location.href = '/user/snacks';
    });

    sessionSelect.addEventListener('change', loadOccupiedSeats);
    loadOccupiedSeats();

    document.querySelectorAll('.fadeIn').forEach(el => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    });
  </script>
</body>
</html>