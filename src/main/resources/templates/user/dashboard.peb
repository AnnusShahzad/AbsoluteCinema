<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Absolute Cinema</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
 <link rel="stylesheet" href="/user/dashboard.css">
  <style>
    .site-footer { margin-top: 64px; border-top: 1px solid rgba(255, 255, 255, 0.08); color: #8a8d99; font-size: 0.9rem; }
    .site-footer a { color: #b9b4d6; text-decoration: none; }
    .site-footer a:hover { color: #fff; }
  </style>
</head>
<body>
  <!-- Theme Toggle -->
  <div class="theme-toggle">
    <div class="dropdown">
      <button class="theme-btn" type="button" id="themeToggle" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-moon-stars-fill"></i>
      </button>
      <ul class="dropdown-menu theme-menu" aria-labelledby="themeToggle">
        <li><button class="dropdown-item theme-item" data-bs-theme-value="light"><i class="bi bi-sun-fill"></i>Light</button></li>
        <li><button class="dropdown-item theme-item active" data-bs-theme-value="dark"><i class="bi bi-moon-stars-fill"></i>Dark</button></li>
        <li><button class="dropdown-item theme-item" data-bs-theme-value="auto"><i class="bi bi-circle-half"></i>Auto</button></li>
      </ul>
    </div>
  </div>

  <!-- Navigation -->
  <div class="nav-container">
    <div class="container py-2">
      <div class="d-flex justify-content-between align-items-center">
        <h1 class="logo-text m-0">Absolute Cinema</h1>
        <div class="search-container">
          <i class="bi bi-search search-icon"></i>
          <input id="searchInput" type="search" class="form-control" placeholder="Search movies..." aria-label="Search movies" autocomplete="off">
          <div id="filterDropdown" class="filter-dropdown dropdown-menu shadow" style="display: none;">
              <div class="filter-section">
                  <div class="filter-section-title">Browse by genre</div>
                  <a class="filter-option" href="/movies/search?genre=Action">Action</a>
                  <a class="filter-option" href="/movies/search?genre=Animation">Animation</a>
                  <a class="filter-option" href="/movies/search?genre=Comedy">Comedy</a>
                  <a class="filter-option" href="/movies/search?genre=Drama">Drama</a>
                  <a class="filter-option" href="/movies/search?genre=Horror">Horror</a>
                  <a class="filter-option" href="/movies/search?genre=Romance">Romance</a>
                  <a class="filter-option" href="/movies/search?genre=Sci-Fi">Sci-Fi</a>
                  <a class="filter-option" href="/movies/search?genre=Thriller">Thriller</a>
              </div>
          </div>
        </div>
      </div>

      <div class="d-flex flex-wrap align-items-center mt-3">
        <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 mb-md-0">
          <li><a href="/user/dashboard" class="nav-link px-2">Home</a></li>
          <li><a href="/movies" class="nav-link px-2">Movies</a></li>
          <li><a href="/bookings/history" class="nav-link px-2">My Bookings</a></li>
          <li><a href="/loyalty" class="nav-link px-2">Loyalty</a></li>
          <li><a href="/feedback" class="nav-link px-2">Feedback</a></li>
          <li><a href="/contact" class="nav-link px-2">Contact</a></li>
          <li><a href="/account/settings" class="nav-link px-2">Settings</a></li>
          <li><a href="/logout" class="nav-link px-2 text-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container">
    <!-- Hero: the three best-selling movies -->
    <section class="hero fadeIn" aria-label="Featured movies">
      {% for movie in movies %}{% if loop.index < 3 %}
      <article class="hero-slide{% if loop.first %} active{% endif %}">
        <div class="hero-backdrop" style="background-image: url('{{ movie.posterUrl | default('/images/movies/default.svg') }}');"></div>
        <div class="hero-shade"></div>
        <img class="hero-poster" src="{{ movie.posterUrl | default('/images/movies/default.svg') }}" alt="{{ movie.title }} poster">
        <div class="hero-content">
          <span class="hero-badge"><i class="bi bi-fire"></i> #{{ loop.index + 1 }} at Absolute Cinema</span>
          <h1 class="hero-title">{{ movie.title }}</h1>
          <div class="hero-meta">
            <span>{{ movie.releaseDate | slice(0, 4) }}</span>
            <span>{{ ((movie.duration - movie.duration % 60) / 60) | numberformat("0") }}h {{ movie.duration % 60 }}m</span>
            <span>{{ movie.genre }}</span>
            <span>{{ movie.language }}</span>
          </div>
          <p class="hero-description">{{ movie.description }}</p>
          <div class="hero-actions">
            <a class="btn-hero-primary" href="/user/seats?movieId={{ movie.id }}"><i class="bi bi-ticket-perforated-fill"></i> Book Now</a>
            <a class="btn-hero-secondary" href="/movies/{{ movie.id }}"><i class="bi bi-info-circle"></i> More Info</a>
          </div>
        </div>
      </article>
      {% endif %}{% endfor %}
      <div class="hero-dots">
        {% for movie in movies %}{% if loop.index < 3 %}
        <button type="button" class="hero-dot{% if loop.first %} active{% endif %}" aria-label="Show {{ movie.title }}"></button>
        {% endif %}{% endfor %}
      </div>
    </section>

    <!-- Trending Now -->
    <div class="mt-5 fadeIn delay-1">
      <h2 class="section-title">Trending Now</h2>
      <div class="slider-section">
        <div class="slider-control slider-prev" onclick="slideLeft()">
          <i class="bi bi-chevron-left"></i>
        </div>
        <div class="slider-control slider-next" onclick="slideRight()">
          <i class="bi bi-chevron-right"></i>
        </div>
        <div id="slider" class="d-flex overflow-x-auto">
          {% for movie in movies %}
          <div class="slider-item">
            <div class="movie-card">
              <div class="position-relative">
                <img src="{{ movie.posterUrl | default('/images/movies/default.svg') }}"
                     class="card-img-top"
                     alt="{{ movie.title }}"
                     loading="lazy"
                     onerror="this.onerror=null; this.src='/images/movies/default.svg'">
                <div class="movie-rating">
                  <i class="bi bi-ticket-perforated-fill"></i> {{ movie.ticketssold }}
                </div>
              </div>
              <div class="card-body">
                <span class="movie-genre">{{ movie.genre }}</span>
                <h5 class="movie-title">{{ movie.title }}</h5>
                <p class="movie-info">
                  <i class="bi bi-clock"></i> {{ movie.duration }} min | <i class="bi bi-translate"></i> {{ movie.language }}
                </p>
                <a class="btn btn-book" href="/user/seats?movieId={{ movie.id }}">Book Now</a>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Top 3 -->
    <div class="mt-5 fadeIn delay-2">
      <h2 class="section-title">Top 3 This Week</h2>
      <div class="top-row">
        {% for movie in movies %}{% if loop.index < 3 %}
        <a class="top-item" href="/movies/{{ movie.id }}" aria-label="#{{ loop.index + 1 }} {{ movie.title }}">
          <span class="top-rank" aria-hidden="true">{{ loop.index + 1 }}</span>
          <img class="top-poster" src="{{ movie.posterUrl | default('/images/movies/default.svg') }}" alt="{{ movie.title }}" loading="lazy">
        </a>
        {% endif %}{% endfor %}
      </div>
    </div>

    <!-- Loyalty promo -->
    <div class="promo-section fadeIn delay-3">
      <div class="promo-content text-center">
        <h3 class="promo-title">Earn while you watch</h3>
        <p class="mb-4">Collect {{ pointsPerTicket }} points for every ticket and {{ pointsPerSnack }} for every snack.
          Redeem {{ redemptionCost }} points for a free ticket at checkout.</p>
        <a class="btn banner-cta" href="/loyalty">View My Points</a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 py-4">
      <span>&copy; 2025 Absolute Cinema</span>
      <nav class="d-flex flex-wrap gap-4" aria-label="Footer">
        <a href="/movies">Movies</a>
        <a href="/bookings/history">My Bookings</a>
        <a href="/loyalty">Loyalty</a>
        <a href="/feedback">Feedback</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Hero rotation
    const heroSlides = document.querySelectorAll('.hero-slide');
    const heroDots = document.querySelectorAll('.hero-dot');
    let currentSlide = 0;

    function showSlide(index) {
      heroSlides[currentSlide].classList.remove('active');
      heroDots[currentSlide].classList.remove('active');
      currentSlide = index;
      heroSlides[currentSlide].classList.add('active');
      heroDots[currentSlide].classList.add('active');
    }

    heroDots.forEach((dot, index) => dot.addEventListener('click', () => showSlide(index)));
    if (heroSlides.length > 1) {
      setInterval(() => showSlide((currentSlide + 1) % heroSlides.length), 7000);
    }

    // Slider Functions
    function slideLeft() {
      const slider = document.getElementById('slider');
      slider.scrollBy({ left: -300, behavior: 'smooth' });
    }

    function slideRight() {
      const slider = document.getElementById('slider');
      slider.scrollBy({ left: 300, behavior: 'smooth' });
    }
  </script>
  <script src="/topbar/bar.js"></script>

</body>
</html>