<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - Absolute Cinema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/checkout.css">
    <meta name="_csrf" content="{{ _csrf.token }}">
    <meta name="_csrf_header" content="{{ _csrf.headerName }}">
</head>
<body>
<header class="checkout-header">
    <a class="checkout-logo" href="/user/dashboard">Absolute Cinema</a>
    <nav class="checkout-steps" aria-label="Booking progress">
        <span class="done"><i class="bi bi-check-circle-fill"></i> Seats</span>
        <span class="done"><i class="bi bi-check-circle-fill"></i> Snacks</span>
        <span class="current">Payment</span>
    </nav>
</header>

<main class="checkout-main">
    <div class="row g-4">
        <div class="col-lg-7">
            <section class="checkout-card">
                <h2>Order summary</h2>
                <p class="mb-1 fw-semibold" id="movie-title"></p>
                <p class="muted" id="session-time"></p>
                <div id="summary-lines">
                    <p class="muted">Calculating your total...</p>
                </div>
            </section>
        </div>

        <div class="col-lg-5">
            <section class="checkout-card">
                <h2>Payment</h2>

                {% if user.points >= redemptionCost %}
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="redeem-points">
                    <label class="form-check-label" for="redeem-points">
                        Use {{ redemptionCost }} of your {{ user.points }} points for a free ticket
                    </label>
                </div>
                {% else %}
                <p class="muted small">You have {{ user.points }} loyalty points. At {{ redemptionCost }} points you can redeem a free ticket.</p>
                {% endif %}

                <form id="payment-form" novalidate>
                    {% if demoMode %}
                    <p class="notice"><i class="bi bi-info-circle"></i> Demo mode: Stripe keys are not configured, so this booking is confirmed without charging a card.</p>
                    {% else %}
                    <label for="card-element" class="form-label">Card details</label>
                    <div id="card-element" class="card-field"></div>
                    {% endif %}
                    <p id="payment-error" class="error-text" role="alert"></p>
                    <button type="submit" class="btn-accent" id="submit-button" disabled>
                        <i class="bi bi-lock-fill"></i> Pay <span id="payment-amount"></span>
                    </button>
                </form>
            </section>
        </div>
    </div>
</main>

{% if not demoMode %}
<script src="https://js.stripe.com/v3/"></script>
{% endif %}
<script>
    const csrf = {
        [document.querySelector('meta[name="_csrf_header"]').content]: document.querySelector('meta[name="_csrf"]').content
    };
    const orderDetails = JSON.parse(sessionStorage.getItem('orderDetails') || '{}');
    const redeemCheckbox = document.getElementById('redeem-points');
    const submitButton = document.getElementById('submit-button');
    const errorText = document.getElementById('payment-error');
    const formatPkr = amount => `PKR ${amount.toLocaleString()}`;

    const stripeKey = '{{ stripePublicKey | escape(strategy="js") }}';
    const stripe = window.Stripe && stripeKey ? Stripe(stripeKey) : null;
    const card = stripe ? stripe.elements().create('card', { style: { base: { color: '#f2f2f7', fontSize: '16px' } } }) : null;
    if (card) {
        card.mount('#card-element');
    }

    // The server prices the order; the page only describes what was picked.
    function buildOrder(paymentMethodId) {
        const snacks = {};
        Object.entries(orderDetails.snacks || {}).forEach(([id, item]) => { snacks[id] = item.quantity; });
        return {
            movieId: Number(orderDetails.movieId),
            sessionId: Number(orderDetails.sessionId),
            seats: (orderDetails.seats || []).map(seat => seat.label),
            snacks,
            applyRedemption: Boolean(redeemCheckbox && redeemCheckbox.checked),
            paymentMethodId: paymentMethodId || null
        };
    }

    async function post(url, body) {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...csrf },
            body: JSON.stringify(body)
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
            throw new Error(result.error || 'Something went wrong. Please try again.');
        }
        return result;
    }

    function line(label, amount, className = '') {
        const row = document.createElement('div');
        row.className = `summary-line ${className}`;
        row.innerHTML = '<span></span><span></span>';
        row.children[0].textContent = label;
        row.children[1].textContent = amount;
        return row;
    }

    async function refreshQuote() {
        submitButton.disabled = true;
        errorText.textContent = '';
        try {
            const quote = await post('/user/payment/quote', buildOrder());
            const lines = [line(`Tickets (${quote.seats.join(', ')})`, formatPkr(quote.ticketTotal))];
            quote.snacks.forEach(snack => lines.push(line(`${snack.name} x ${snack.quantity}`, formatPkr(snack.amount))));
            if (quote.discount > 0) {
                lines.push(line('Loyalty reward', `- ${formatPkr(quote.discount)}`, 'discount'));
            }
            lines.push(line('Total', formatPkr(quote.total), 'total'));
            document.getElementById('summary-lines').replaceChildren(...lines);
            document.getElementById('payment-amount').textContent = formatPkr(quote.total);
            submitButton.disabled = false;
        } catch (error) {
            errorText.textContent = error.message;
        }
    }

    document.getElementById('payment-form').addEventListener('submit', async event => {
        event.preventDefault();
        submitButton.disabled = true;
        errorText.textContent = '';
        try {
            let paymentMethodId = null;
            if (card) {
                const { paymentMethod, error } = await stripe.createPaymentMethod({ type: 'card', card });
                if (error) {
                    throw new Error(error.message);
                }
                paymentMethodId = paymentMethod.id;
            }
            const result = await post('/user/payment/process', buildOrder(paymentMethodId));
            sessionStorage.removeItem('orderDetails');
            window.location.href = result.redirectUrl;
        } catch (error) {
            errorText.textContent = error.message;
            submitButton.disabled = false;
        }
    });

    if (!orderDetails.sessionId || !(orderDetails.seats || []).length) {
        document.getElementById('summary-lines').innerHTML =
            '<p class="muted">Your order is empty. <a href="/movies">Pick a movie and seats</a> to continue.</p>';
    } else {
        document.getElementById('movie-title').textContent = orderDetails.movieTitle || '';
        document.getElementById('session-time').textContent = orderDetails.sessionTime || '';
        if (redeemCheckbox) {
            redeemCheckbox.addEventListener('change', refreshQuote);
        }
        refreshQuote();
    }
</script>
</body>
</html>
