<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Absolute Cinema - Cinema Management System</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #0a0a10;
        }
        
        .container {
            display: flex;
            width: 85vw;
            height: 85vh;
            max-width: 1200px;
            max-height: 700px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4), 0 15px 30px rgba(0, 0, 0, 0.2); /* Shadow for 3D effect */
            border-radius: 20px;
            overflow: hidden;
            position: relative;
        }
        
        .signup-form {
            flex: 1;
            background-color: #141620;
            padding: 10% 8%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            z-index: 1;
            text-align: center;
        }
        
        .welcome-section {
            flex: 1.5;
            background: linear-gradient(135deg, #722ed1, #1677ff, #165dff);
            padding: 10%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            transition: all 0.5s ease;
        }
        
        .welcome-section:hover {
            background: linear-gradient(135deg, #7b36d7, #2684ff, #2067ff);
        }
        
        .bubble {
            position: absolute;
            border-radius: 50%;
            opacity: 0.6;
            transition: all 0.8s ease;
        }
        
        .container:hover .bubble {
            transform: scale(1.1) translateY(-10px);
        }
        
        .bubble:nth-child(1) {
            top: 15%;
            right: 20%;
            width: 180px;
            height: 180px;
            background: linear-gradient(135deg, #9e68ff, #6942ff);
            filter: blur(2px);
        }
        
        .bubble:nth-child(2) {
            bottom: 20%;
            left: 10%;
            width: 140px;
            height: 140px;
            background: linear-gradient(135deg, #ff9a9e, #ff6a88);
            filter: blur(2px);
        }
        
        .bubble:nth-child(3) {
            top: 60%;
            right: 15%;
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #ffcc70, #ff9a6c);
            filter: blur(2px);
        }
        
        h2 {
            margin-bottom: 30px;
            color: #ffffff;
            font-size: 42px;
            font-weight: 600;
            font-family: 'Playfair Display', serif;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }
        
        .logo {
            margin-bottom: 40px;
            font-size: 28px;
            font-weight: bold;
            background: linear-gradient(to right, #722ed1, #1677ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1.5px;
            font-family: 'Playfair Display', serif;
            position: relative;
            display: inline-block;
        }
        
        .logo::after {
            content: '';
            position: absolute;
            width: 40px;
            height: 3px;
            background: linear-gradient(to right, #722ed1, #1677ff);
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
        }
        
        .form-group {
            margin-bottom: 25px;
            position: relative;
        }
        
        .form-control {
            width: 100%;
            padding: 18px 20px 18px 50px;
            border: 1px solid #32343e;
            border-radius: 10px;
            font-size: 16px;
            outline: none;
            transition: all 0.3s;
            background-color: #1e2130;
            color: #e4e4e4;
        }
        
        .form-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #606273;
        }
        
        .form-control::placeholder {
            color: #606273;
        }
        
        .form-control:focus {
            border-color: #722ed1;
            box-shadow: 0 0 0 2px rgba(114, 46, 209, 0.2);
        }
        
        .form-control:focus + .form-icon {
            color: #722ed1;
        }
        
        .forgot-link {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .forgot-link a {
            color: #8a8d99;
            text-decoration: none;
            font-size: 15px;
            transition: all 0.3s;
        }
        
        .forgot-link a:hover {
            color: #722ed1;
        }
        
        .btn {
            width: 100%;
            padding: 18px;
            border: none;
            border-radius: 50px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background: linear-gradient(to right, #722ed1, #1677ff);
            color: white;
            box-shadow: 0 5px 20px rgba(114, 46, 209, 0.4);
        }
        
        .btn-primary:hover {
            box-shadow: 0 8px 25px rgba(114, 46, 209, 0.6);
            transform: translateY(-2px);
        }
        
        .welcome-content {
            text-align: center;
            color: white;
            position: relative;
            z-index: 2;
        }
        
        .welcome-content h2 {
            font-size: 48px;
            margin-bottom: 15px;
            color: #fff;
        }
        
        .welcome-content p {
            margin-bottom: 10px;
            font-size: 18px;
            line-height: 1.6;
            opacity: 0.9;
        }
        
        .cinema-quote {
            margin-top: 30px;
            font-style: italic;
            font-size: 17px;
            line-height: 1.6;
            opacity: 0.95;
            max-width: 90%;
            padding: 15px;
            border-left: 3px solid rgba(255, 255, 255, 0.5);
        }
        
        .signup-link {
            text-align: center;
            margin-top: 25px;
            color: #6c7293;
            font-size: 15px;
        }
        
        .signup-link a {
            color: #722ed1;
            text-decoration: none;
            margin-left: 5px;
            font-weight: 500;
            transition: all 0.3s;
        }
        
        .signup-link a:hover {
            color: #1677ff;
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            .container {
                flex-direction: column;
                width: 95vw;
                height: auto;
            }
            
            .welcome-section {
                padding: 40px 20px;
            }
            
            .signup-form {
                padding: 40px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Welcome Section (Blue Part) -->
        <div class="welcome-section">
            <div class="bubble"></div>
            <div class="bubble"></div>
            <div class="bubble"></div>
            
            <div class="welcome-content">
                <h2 style="font-size: 37px;">Join Absolute Cinema</h2> 
                <div class="cinema-quote">
                    "Cinema is a mirror by which we often see ourselves. Through the silver screen, we connect with our emotions, dreams, and the stories that shape our lives."
                </div>
                <br>
                <p>Sign Up and Experience the Best of Cinema!</p>
            </div>
        </div>
        
        <!-- Signup Form (Black Part) -->
        <form class="signup-form" method="POST" action="/auth/register">
            <input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}" />
            <div class="logo">ABSOLUTE CINEMA</div>
            <br>
            {% if error %}
                <div class="error-message" style="color: #ff6b6b;" role="alert">{{ error }}</div>
            {% endif %}
            <div class="form-group">
                <input type="text" name="username" id="username" class="form-control" placeholder="Username" value="{{ form.username }}" pattern="[A-Za-z0-9_.]{3,30}" title="3-30 letters, numbers, dots or underscores" autocomplete="username" required>
                <i class="fas fa-user form-icon"></i>
            </div>
            
            <div class="form-group">
                <input type="text" name="firstName" id="firstName" class="form-control" placeholder="First Name" value="{{ form.firstName }}" maxlength="50" autocomplete="given-name" required>
                <i class="fas fa-user form-icon"></i>
            </div>
            
            <div class="form-group">
                <input type="text" name="lastName" id="lastName" class="form-control" placeholder="Last Name" value="{{ form.lastName }}" maxlength="50" autocomplete="family-name" required>
                <i class="fas fa-user form-icon"></i>
            </div>
            
            <div class="form-group">
                <input type="email" name="email" id="email" class="form-control" placeholder="Email" value="{{ form.email }}" autocomplete="email" required>
                <i class="fas fa-envelope form-icon"></i>
            </div>
            
            <div class="form-group">
                <input type="password" name="password" id="password" class="form-control" placeholder="Password (8+ characters)" minlength="8" autocomplete="new-password" required>
                <i class="fas fa-lock form-icon"></i>
            </div>
            
            <div class="form-group">
                <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm Password" autocomplete="new-password" required>
                <i class="fas fa-lock form-icon"></i>
            </div>
            
            <button type="submit" class="btn btn-primary" id="submitBtn" style="position: absolute;top: 560px;left:100px;width: 300px;height: 40px;padding: 10px;">SIGN UP</button>
            
            <div class="signup-link" style="position: absolute;top: 590px;left:120px;">
                Already have an account? <a href="/auth/login">Sign In</a>
            </div>
        </div>
    </div>


    <script>
        // Get form inputs
        const passwordField = document.getElementById('password');
        const confirmPasswordField = document.getElementById('confirmPassword');
        
        // The browser checks required fields and formats; the server re-validates everything.
        confirmPasswordField.addEventListener('input', () => {
            confirmPasswordField.setCustomValidity(
                confirmPasswordField.value === passwordField.value ? '' : 'Passwords do not match');
        });
    </script>
</body>
</html>