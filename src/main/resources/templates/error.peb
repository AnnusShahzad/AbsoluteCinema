<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ status }} - Absolute Cinema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/checkout.css">
</head>
<body>
<header class="checkout-header">
    <a class="checkout-logo" href="/">Absolute Cinema</a>
</header>
<main class="checkout-main text-center" style="max-width: 560px; padding-top: 8vh;">
    <p class="display-1 fw-bold mb-2" style="background: linear-gradient(90deg, #722ed1, #1677ff); -webkit-background-clip: text; color: transparent;">{{ status }}</p>
    {% if status == 404 %}
    <h1 class="h4 mb-3">We couldn't find that page</h1>
    <p class="muted mb-4">The link may be broken, or the page may have moved.</p>
    {% elseif status == 403 %}
    <h1 class="h4 mb-3">You don't have access to this page</h1>
    <p class="muted mb-4">Sign in with an account that has permission, or head back home.</p>
    {% else %}
    <h1 class="h4 mb-3">Something went wrong</h1>
    <p class="muted mb-4">Please try again in a moment. If it keeps happening, let us know through the contact page.</p>
    {% endif %}
    <a class="btn-accent" href="/" style="width: auto;">Back to home</a>
</main>
</body>
</html>
